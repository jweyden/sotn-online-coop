<Project Sdk="Microsoft.NET.Sdk">
  <!-- The kit's extractor: builds the PSP and Saturn characters from the player's own
       discs, with no other tools (it replaces the Docker builder). Setup runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sotn-extract</AssemblyName>
  </PropertyGroup>
</Project>
